# Copiar a .env y completar. Nunca commitear .env.

NODE_ENV=development
PORT=3002

# Supabase (opcionales en desarrollo; requeridos en produccion)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CORS hacia el frontend
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# PostgreSQL. Prisma usa DIRECT_URL para migraciones (conexion directa)
# y DATABASE_URL para el pooler.
# Ambas son obligatorias para `prisma validate|generate|migrate`.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://usuario:password@host:5432/postgres
