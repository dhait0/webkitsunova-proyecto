# ==========================================
# SUPABASE — Pega aquí tus claves
# Obtén tus claves en: Supabase → Project Settings → API
#
# NEXT_PUBLIC_* llega al navegador. SUPABASE_SECRET_KEY nunca debe salir
# del servidor: `lib/supabase/admin.ts` la marca `server-only`.
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# ==========================================
# PRISMA — Obtén estas dos cadenas en:
# Supabase → Connect → Connection strings
#
# DATABASE_URL: selecciona "Transaction pooler" (puerto 6543)
# DIRECT_URL: selecciona "Direct Connection" (puerto 5432)
# Si Direct no funciona desde tu red, usa "Session pooler" (puerto 5432)
# NO copies hostnames manualmente — cópialos desde Connect.
#
# El pooler es obligatorio en Vercel: las conexiones directas agotan el
# número máximo de clientes de PostgreSQL en serverless.
# ==========================================
# DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres?...
# DIRECT_URL=postgresql://...supabase.co:5432/postgres?...

# ==========================================
# Seed (solo desarrollo local)
# ==========================================
SEED_ADMIN_EMAIL=admin@kitsunova.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Kitsunova
